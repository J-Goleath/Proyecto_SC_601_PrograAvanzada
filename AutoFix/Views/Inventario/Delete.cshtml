@model AutoFix.Application.DTOs.RepuestoDTO

@{
    ViewBag.Title = "Eliminar Repuesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Eliminar Repuesto</h2>

    <div class="alert alert-danger">
        <h4>¿Está seguro que desea eliminar este repuesto?</h4>
        <p>Esta acción no se puede deshacer.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Codigo</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Categoria</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3">Stock</dt>
                <dd class="col-sm-9">@Model.Stock</dd>

                <dt class="col-sm-3">Precio</dt>
                <dd class="col-sm-9">@String.Format("{0:C}", Model.Precio)</dd>

                <dt class="col-sm-3">Ubicacion</dt>
                <dd class="col-sm-9">@Model.Ubicacion</dd>

                <dt class="col-sm-3">Descripcion</dt>
                <dd class="col-sm-9">@Model.Descripcion</dd>
            </dl>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Eliminar
            </button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>
