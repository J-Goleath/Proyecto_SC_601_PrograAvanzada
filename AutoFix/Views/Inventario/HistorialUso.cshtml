@model IEnumerable<AutoFix.Application.DTOs.MaterialUsadoHistorialDTO>

@{
    ViewBag.Title = "Historial de Uso de Materiales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Historial de Uso de Materiales</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Orden de Trabajo</th>
                    <th>Repuesto</th>
                    <th>Cantidad</th>
                    <th>Costo Unitario</th>
                    <th>Total</th>
                    <th>Fecha de Uso</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>OT-@item.OrdenTrabajoId (@item.OrdenTrabajoEstado)</td>
                        <td>@item.RepuestoNombre</td>
                        <td>@item.Cantidad</td>
                        <td>@String.Format("{0:C}", item.CostoUnitario)</td>
                        <td>@String.Format("{0:C}", item.Total)</td>
                        <td>@item.FechaUso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Observaciones</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
