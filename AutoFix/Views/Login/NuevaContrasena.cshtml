@{
    ViewBag.Title = "Nueva Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4><i class="fas fa-lock"></i> Nueva Contraseña</h4>
                </div>
                <div class="card-body">

                    <p class="text-muted">Identidad verificada. Ingrese su nueva contraseña.</p>

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label for="nuevaContrasena" class="font-weight-bold">Nueva Contraseña</label>
                            <input type="password" name="nuevaContrasena" id="nuevaContrasena" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6" />
                        </div>

                        <div class="form-group mb-3">
                            <label for="confirmarContrasena" class="font-weight-bold">Confirmar Contraseña</label>
                            <input type="password" name="confirmarContrasena" id="confirmarContrasena" class="form-control" placeholder="Repita la contraseña" required minlength="6" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Guardar Nueva Contraseña
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>