@model IEnumerable<AutoFix.Entities.OrdenTrabajo>

@{
    ViewBag.Title = "Órdenes de Trabajo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Órdenes de Trabajo</h4>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Cita</th>
                        <th>Cliente</th>
                        <th>Mecánico</th>
                        <th>Estado</th>
                        <th>Prioridad</th>
                        <th>Fecha Asignación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CitaSolicitudId</td>

                            <td>
                                @if (item.Cliente != null)
                                {
                                    @item.Cliente.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">Sin cliente</span>
                                }
                            </td>

                            <td>
                                @if (item.Mecanico != null)
                                {
                                    @item.Mecanico.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">Sin mecánico</span>
                                }
                            </td>

                            <td>@item.Estado</td>

                            <td>@item.Prioridad</td>

                            <td>@item.FechaAsignacion.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                                @Html.ActionLink("Detalle", "Detalle", new { id = item.Id }, new { @class = "btn btn-info btn-sm mb-1" })

                                @Html.ActionLink("Actualizar", "ActualizarEstado", new { id = item.Id }, new { @class = "btn btn-warning btn-sm mb-1" })

                                @using (Html.BeginForm("Eliminar", "OrdenTrabajo", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm mb-1"
                                            onclick="return confirm('¿Está seguro que desea eliminar esta orden de trabajo?');">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>